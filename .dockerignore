# Docker build context excludes.
# The main Dockerfile does `COPY . .`, so anything not excluded here is baked
# into the image. Goal: a slim (<500 MB) production image that ships only the
# server, the OpenEnv contract (models.py), the agent entry points, and the
# manifest. Large weights, datasets, and RL checkpoints are mounted at runtime
# (see docker-compose.yml) — never baked in.

# ── Version control & Python caches ──────────────────────────────
.git/
.gitignore
.gitattributes
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtualenvs ──────────────────────────────────────────────────
.venv/
venv/
env/

# ── Secrets & local env (never bake keys) ────────────────────────
.env
.env.*

# ── Large model weights & datasets (mounted at runtime) ──────────
models/
external_data/
rl/checkpoints/
rl/data/
wandb/
.openrouter_cache/

# ── Legacy / historical trees ────────────────────────────────────
# P0.3 DONE: the live war-room + phoenix modules were promoted OUT of versions/
# into the installable supplymind/ package (which is NOT excluded, so it ships
# in the image and server/app.py imports it directly). versions/ now holds only
# historical material (v3_arcadia, v5 docs/experiments/receipts_v2/roll_integration/
# rap_xc/gnn_v2) — safe to exclude from the runtime image.
versions/
_dump/
FINAL_SUBMIT/
notebooks/

# ── Tests & receipts (not needed at runtime) ─────────────────────
tests/

# ── Sibling archive tree (defensive; normally outside context) ───
Sleep-Token-ARCHIVE/

# ── Build artifacts / IDE ────────────────────────────────────────
dist/
build/
.vscode/
.idea/

# ── Docs & markdown (keep README for the image) ──────────────────
*.md
!README.md
