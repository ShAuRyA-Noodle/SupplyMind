# SupplyMind .env.example — copy to .env and fill in
# .env is gitignored. NEVER commit real keys.
# Every name below is read by the code; values here are placeholders only.

# ── LLM backbone (primary) ───────────────────────────────────────
# OpenRouter is the primary AI gateway for the analyst / baseline / judge panel.
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Optional OpenRouter attribution headers (shown on your OpenRouter dashboard).
OPENROUTER_SITE_URL=https://your-site-or-repo-url
OPENROUTER_APP_NAME=SupplyMind

# Provider switch for supplymind.llm.providers: "openrouter" (default) or
# "ollama" (local/edge mode). Never hardcoded — always read from here.
SUPPLYMIND_LLM_PROVIDER=openrouter

# LLM endpoint + model used by baseline.py / inference.py.
# Defaults (if unset): API_BASE_URL=https://openrouter.ai/api/v1,
#                      MODEL_NAME=qwen/qwen-2.5-72b-instruct
# API_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=qwen/qwen-2.5-72b-instruct

# Alternative names the baseline endpoint accepts if OPENROUTER_API_KEY is unset
# (server/app.py checks OPENROUTER_API_KEY, then API_KEY, then OPENAI_API_KEY).
# API_KEY=your_llm_key_here
# OPENAI_API_KEY=your_openai_key_here

# Ollama edge mode (only used when SUPPLYMIND_LLM_PROVIDER=ollama).
# Default endpoint if unset: http://127.0.0.1:11434
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Live data / experiment API keys ──────────────────────────────
# Federal Reserve Economic Data (FRED) — commodity prices, FX, macro
# Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key_here

# U.S. Energy Information Administration (EIA) — petroleum / energy series
# Free: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_key_here

# NASA FIRMS — thermal anomaly / active-fire feed (MAP_KEY)
# Free: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Global Fishing Watch (GFW) — AIS vessel / port-visit tracking (bearer JWT)
# Free (token request): https://globalfishingwatch.org/our-apis/tokens
GFW_API_TOKEN=your_gfw_jwt_token_here

# NewsAPI — geopolitical event polling (Hormuz, Iran, Israel, Red Sea)
# Free 100 req/day: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# NOAA — weather / tropical cyclone feed (CDO token)
# Free: https://www.ncdc.noaa.gov/cdo-web/token
NOAA_TOKEN=your_noaa_token_here

# MarineTraffic — optional AIS fallback (only used if set; GFW is primary).
# MARINETRAFFIC_API_KEY=your_marinetraffic_key_here

# GDELT and USGS are keyless / free tier — no env var needed.

# ── SEC EDGAR ─────────────────────────────────────────────────────
# SEC EDGAR requires a contact e-mail in the User-Agent for automated fetches.
# No personal address is baked into the code — you supply one here.
SEC_CONTACT_EMAIL=you@example.com

# ── Optional infrastructure ──────────────────────────────────────
# Weights & Biases — experiment tracking (optional)
# Free: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_key_here

# Hugging Face — model downloads + Space deploy
# Free: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here
